[flask]
secret_key = REEMPLAZAR_CON_64_CARACTERES_ALEATORIOS
host = 0.0.0.0
port = 5040
session_cookie_secure = false

[security]
force_https = false
trust_proxy_headers = false
trusted_proxy_hops = 1
session_cookie_samesite = Lax
session_absolute_minutes = 720
session_idle_minutes = 30
session_validation_seconds = 120
max_failed_logins = 5
max_failed_logins_ip = 20
login_rate_window_minutes = 15
login_lock_minutes = 15
hsts_seconds = 31536000
content_security_policy = default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'

[oracle]
# Oracle local de Billing One: autorización, configuración y tablas RM_CFACT_.
user = USUARIO_ORACLE
password = PASSWORD_ORACLE
dsn = HOST:1521/SERVICE_NAME
pool_min = 1
pool_max = 8
pool_increment = 1
thick_mode = true
client_lib_dir = C:\\oracle\\instantclient

[ldap]
# LDAP se usa exclusivamente para autenticar el acceso web corporativo.
enabled = true
servers = ldap1.empresa.local,ldap2.empresa.local
port = 636
use_ssl = true
start_tls = false
validate_certificate = true
ca_cert_file = C:\\certificados\\ca_corporativa.pem
tls_ciphers = DEFAULT
allow_legacy_ciphers = false
authentication = SIMPLE
login_format = UPN
domain_suffix = clarochile.org
netbios_domain = CLAROCHILE
connect_timeout = 5
receive_timeout = 8

[sqlserver_fact]
# Referencia opcional. Las nuevas fuentes deben administrarse desde
# Fuentes e Integraciones y usar CREDENTIAL_REF cuando corresponda.
enabled = false
driver = ODBC Driver 18 for SQL Server
server = SERVIDOR_SQL
port = 1433
database = BASE_FACTURACION
user = USUARIO_SQL
password = PASSWORD_SQL
encrypt = yes
trust_server_certificate = no

[credential.EXAMPLE_ORACLE]
user = USUARIO_ORIGEN
password = PASSWORD_ORIGEN

[credential.EXAMPLE_SQLSERVER]
user = USUARIO_ORIGEN
password = PASSWORD_ORIGEN

[credential.EXAMPLE_REST]
token = TOKEN_ORIGEN

[ai]
enabled = false
provider = none
